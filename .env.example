# ================= 大模型配置 =================
# 兼容两套变量名：LLM_* 或 DEEPSEEK_*
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
# 结构化输出方式：DeepSeek 用 function_calling（json_schema 会报 400）
LLM_STRUCTURED_METHOD=function_calling

# ================= 服务配置 =================
APP_NAME=DataAnalysisAgent
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false

# ================= 上传与存储 =================
MAX_FILE_SIZE=209715200
ALLOWED_FILE_TYPES=.csv,.xlsx,.xls,.txt,.tsv
STORAGE_DIR=./storage
MAX_ROWS=200000

# ================= Agent 行为 =================
MAX_TOOL_ROUNDS=8
HISTORY_WINDOW=24
CHART_DPI=120
CHART_THEME=seaborn-v0_8-darkgrid
